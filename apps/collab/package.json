    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hocuspocus/provider": "4.8.0",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "ws": "8.23.0"
  }
}
