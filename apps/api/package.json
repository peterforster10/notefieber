{
  "name": "@notefieber/api",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.local/zitadel.env --env-file-if-exists=../../.env src/api.ts",
    "dev:worker": "node --watch --env-file-if-exists=../../.local/zitadel.env --env-file-if-exists=../../.env src/worker.ts",
    "start": "node src/api.ts",
    "start:worker": "node src/worker.ts",
    "typecheck": "tsc -p .",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@notefieber/shared": "workspace:*",
    "express": "5.3.0",
    "openid-client": "6.8.9",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1"
  }
}
