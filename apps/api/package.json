{
  "name": "@notefieber/api",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.local/zitadel.env --env-file-if-exists=../../.env src/api.ts",
    "dev:worker": "node --watch --env-file-if-exists=../../.local/zitadel.env --env-file-if-exists=../../.env src/worker.ts",
    "start": "node src/api.ts",
    "start:worker": "node src/worker.ts",
    "typecheck": "tsc -p .",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:db": "node --test \"src/**/*.dbtest.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@notefieber/editor-schema": "workspace:*",
    "@notefieber/shared": "workspace:*",
    "express": "5.3.0",
    "fractional-indexing": "4.0.0",
    "openid-client": "6.9.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1"
  }
}
