# Vorlage für die Datei .env im Wurzelordner (nicht im Repository), nur für den eigenen
# Rechner. Kopieren und bei Bedarf anpassen:  cp .env.example .env
# Die Apps lesen .env beim Start (node --env-file-if-exists); docker compose liest dieselbe
# Datei für seine eigenen Variablen (siehe Kopf von compose.yaml). Siehe docs/LOCAL_SETUP.md.

# --- Datenbank: eine Login-Rolle pro App (database/scripts/local_login_roles.sql) ---------
# Nie als wiki_owner oder postgres: Die Apps brechen dann beim Start ab.
API_DATABASE_URL=postgres://wiki_api:api-lokal@localhost:5432/wiki
WORKER_DATABASE_URL=postgres://wiki_jobs:jobs-lokal@localhost:5432/wiki
COLLAB_DATABASE_URL=postgres://wiki_collab:collab-lokal@localhost:5432/wiki

# --- Ports -------------------------------------------------------------------------------
API_PORT=4000
COLLAB_PORT=1234
# Das Frontend läuft auf 3000 (Redirect-URL in Zitadel: http://localhost:3000/auth/callback)
NEXT_PUBLIC_API_URL=http://localhost:4000
WORKER_INTERVAL_SECONDS=30

# --- Dateien: Garage (docs/LOCAL_SETUP.md, Abschnitt 5), noch nicht genutzt ---------------
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=wiki
S3_ACCESS_KEY_ID=GK6e6f74656669656265720001
S3_SECRET_ACCESS_KEY=6c6f6b616c2d6e75722d7a756d2d656e747769636b656c6e2d67617261676521
S3_FORCE_PATH_STYLE=true

# --- Login: Zitadel ----------------------------------------------------------------------
# Client-IDs und Geheimnis schreibt zitadel-init nach .local/zitadel.env (Abschnitt 6);
# die Apps lesen sie dort, sobald der Login gebaut ist (E03). Hier nichts eintragen.
