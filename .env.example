# Vorlage für die Datei .env im Wurzelordner (nicht im Repository), nur für den eigenen
# Rechner. Kopieren und bei Bedarf anpassen:  cp .env.example .env
# Die Apps lesen .env beim Start (node --env-file-if-exists); docker compose liest dieselbe
# Datei für seine eigenen Variablen (siehe Kopf von compose.yaml). Siehe docs/LOCAL_SETUP.md.

# --- Datenbank: eine Login-Rolle pro App (database/scripts/local_login_roles.sql) ---------
# Nie als wiki_owner oder postgres: Die Apps brechen dann beim Start ab.
API_DATABASE_URL=postgres://wiki_api:api-lokal@localhost:5432/wiki
WORKER_DATABASE_URL=postgres://wiki_jobs:jobs-lokal@localhost:5432/wiki
COLLAB_DATABASE_URL=postgres://wiki_collab:collab-lokal@localhost:5432/wiki

# --- Ports -------------------------------------------------------------------------------
API_PORT=4000
COLLAB_PORT=1234
WORKER_INTERVAL_SECONDS=30
# Frontend und API erscheinen für den Browser unter einer Adresse: Das Frontend (Port 3000)
# leitet /api an die API weiter (apps/web/next.config.ts), wie später der Ingress.
PUBLIC_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000

# --- Dateien: Garage (docs/LOCAL_SETUP.md, Abschnitt 5), noch nicht genutzt ---------------
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=wiki
S3_ACCESS_KEY_ID=GK6e6f74656669656265720001
S3_SECRET_ACCESS_KEY=6c6f6b616c2d6e75722d7a756d2d656e747769636b656c6e2d67617261676521
S3_FORCE_PATH_STYLE=true

# --- Login: Zitadel über OIDC (docs/LOCAL_SETUP.md, Abschnitte 6 und 7) -----------------
# OIDC_ISSUER, OIDC_CLIENT_ID, OIDC_CLIENT_SECRET und OIDC_REDIRECT_URI schreibt zitadel-init
# nach .local/zitadel.env; die API liest diese Datei vor der .env. Hier nichts eintragen.
# Lokal läuft Zitadel über http, und die Cookies gehen ohne HTTPS:
OIDC_ALLOW_HTTP=true
COOKIE_SECURE=false
# Signiert das kurzlebige Cookie zwischen Login-Start und Rücksprung (mindestens 32 Zeichen)
AUTH_COOKIE_SECRET=lokal-nur-zum-entwickeln-mindestens-32-zeichen
SESSION_HOURS=12
# Welche Claims Person und Organisation enthalten (Standard: Zitadel). Nur für einen anderen
# Login-Dienst ändern, siehe apps/api/src/auth/claims.ts:
# OIDC_CLAIM_SUBJECT=sub
# OIDC_CLAIM_ORG=urn:zitadel:iam:user:resourceowner:id
# OIDC_SCOPES=openid profile email urn:zitadel:iam:user:resourceowner
# OIDC_ORG_SCOPE=urn:zitadel:iam:org:id:{orgId}
# Kurzname des Mandanten, den die Anmeldeseite vorschlägt
NEXT_PUBLIC_DEFAULT_TENANT=alpenwerk
